    # 12-core host, 2026-11-08 (bennett-plugin-job-vzv .tmp/r3-transports/
    # orch-repro.log); 10x is below the 60 s floor.
    "native_transports": 60,
}
SUITE_HANG_GUARD_S = 2655
UNKNOWN_EXIT_STATUS = 124


def run_command(command, environment, started):
    command_started = time.monotonic()
    label = " ".join(command[2:])
    remaining = SUITE_HANG_GUARD_S - (command_started - started)
    if remaining <= 0:
        print(f"UNKNOWN: hang guard {SUITE_HANG_GUARD_S} s exceeded by {label}", file=sys.stderr, flush=True)
        raise SystemExit(UNKNOWN_EXIT_STATUS)
    command_guard = COMMAND_HANG_GUARDS_S[Path(command[2]).stem]
    guard = SUITE_HANG_GUARD_S if remaining < command_guard else command_guard
    try:
        result = subprocess.run(
            command,
            cwd=ROOT,
            env=environment,
            text=True,
            capture_output=True,
            timeout=min(command_guard, remaining),
        )
    except subprocess.TimeoutExpired:
        print(f"UNKNOWN: hang guard {guard} s exceeded by {label}", file=sys.stderr, flush=True)
        raise SystemExit(UNKNOWN_EXIT_STATUS) from None
    receipt = {"argv": command[2:], "elapsed_s": round(time.monotonic() - command_started, 3)}
    print(f"{label}: exit {result.returncode}", flush=True)
    if result.returncode:
        print(result.stdout)
        print(result.stderr, file=sys.stderr)
        raise SystemExit(result.returncode)
    return receipt


def run_commands(commands, environment, started):
    return [run_command(command, environment, started) for command in commands]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--major", action="append", type=int, choices=(18, 23))
    args = parser.parse_args()
    environment = dict(os.environ)
    for key in ("DISPLAY", "WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS", "BROWSER"):
        environment.pop(key, None)
    temporary = ROOT / ".tmp/tests"
    temporary.mkdir(parents=True, exist_ok=True)
    environment.setdefault("TMPDIR", str(temporary))
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    policies = [[sys.executable, "-B", f"tests/{name}.py"] for name in POLICIES]
    policies.append(["bash", "-e", "tests/native_transports.sh"])
    groups = [
        [
            [sys.executable, "-B", f"tests/{name}.py", "--major", str(major),
             *(option.format(major=major) for option in options)]
            for name, options in DRIVERS.items()
        ] + [[
            sys.executable, "-B", "tests/review_regressions.py", "--major", str(major),
            *(argument for name in REGRESSIONS for argument in ("--case", name)),
        ]]
        for major in args.major or (18, 23)
    ]
    started = time.monotonic()
    receipts = run_commands(policies, environment, started)
    # Independent major-local artifacts; preserve prerequisite order within each major.
    with ThreadPoolExecutor(max_workers=2) as pool:
        receipts += sum(pool.map(run_commands, groups, repeat(environment), repeat(started)), [])
    receipt = {
        "commands": len(receipts), "elapsed_s": round(time.monotonic() - started, 3),
        "checks": receipts,
    }
    (temporary / "default.json").write_text(json.dumps(receipt, indent=2) + "\n")
    print(json.dumps({key: receipt[key] for key in ("commands", "elapsed_s")}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
