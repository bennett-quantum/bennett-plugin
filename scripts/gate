#!/usr/bin/env bash
# The full gate, run in the tree this script lives in. Prefer scripts/pre-push, which
# gates a clean checkout of the commit being pushed (or HEAD). Use this directly only
# to iterate on a dirty tree; its results are not a push gate.
set -euo pipefail
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
root="$(cd "$script_dir/.." && pwd)"
unset DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS BROWSER
export TMPDIR="${TMPDIR:-$root/.tmp}"
mkdir -p "$TMPDIR"
# Resolve arithmetic before any plugin subprocess inherits its implicit input.
BENNETT_ARITH_PINNED_ROOT="$(python3 - "$root" <<'PYTHON'
import sys
sys.path.insert(0, sys.argv[1]+'/tests')
from contracts import arith_path
for major in (18,23): print(f'arith LLVM {major}: {arith_path(major)}', file=sys.stderr, flush=True)
print(arith_path(18).parent.parent)
PYTHON
)"
export BENNETT_ARITH_PINNED_ROOT
# Default: the fast (pre-merge) tier. --entry-snapshot: the whole gate, entry snapshots and the cross-major comparison
# included (post-merge tier; it runs in its own clean worktree, so it reruns everything it compares).
case "${1:-}" in
  "") full=0 ;;
  --entry-snapshot) full=1 ;;
  *) echo "usage: scripts/gate [--entry-snapshot]" >&2; exit 3 ;;
esac
/usr/bin/time -f 'gate build: %e s' "$root/scripts/build"
"$root/scripts/test"
# Keep measured slow checks outside scripts/test's shared allowance.
# Measured 2026-11-07 on tobias-ThinkPad-X1-Carbon-Gen-11 (LLVM 18/23):
# r_typed_faults: 46.490/87.298 s; recursive opt: 28.141/46.035 s with
# its existing 60 s subprocess bound (other subprocesses: 120 s).
# r_envelopes: 0.566/0.817 s total with existing 120 s subprocess bounds.
for major in 18 23; do
  /usr/bin/time -f "gate mixed-native LLVM $major: %e s" python3 "$root/tests/review_regressions.py" --major "$major" --case mixed-native
  /usr/bin/time -f "gate r_typed_faults LLVM $major: %e s" python3 "$root/tests/r_typed_faults.py" --major "$major"
  /usr/bin/time -f "gate r_envelopes LLVM $major: %e s" python3 "$root/tests/r_envelopes.py" --major "$major"
done
if (( full )); then
  # Independent snapshot executions are CPU-heavy; their artifacts are major-local.
  /usr/bin/time -f "gate entry-snapshot LLVM 18: %e s" python3 "$root/tests/entry_snapshot.py" --major 18 &
  snapshot18=$!
  /usr/bin/time -f "gate entry-snapshot LLVM 23: %e s" python3 "$root/tests/entry_snapshot.py" --major 23 &
  snapshot23=$!
  wait "$snapshot18"
  wait "$snapshot23"
  /usr/bin/time -f "gate production_cross_major: %e s" python3 "$root/tests/production_cross_major.py"
fi
/usr/bin/time -f "gate prior_objects: %e s" python3 "$root/tests/prior_objects.py"
/usr/bin/time -f "gate corpus_gate: %e s" python3 "$root/tests/corpus_gate.py"
